# Environnement d'execution (development | production)
NODE_ENV=development

# Secret utilise pour signer les cookies de session (obligatoire en production)
SESSION_SECRET=change-me

# Compte admin cree/promu automatiquement au demarrage (optionnel)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Base de donnees Postgres (optionnel en dev - fallback SQLite si absent)
POSTGRES_URL=postgres://user:password@localhost:5432/dbname

# Google OAuth (optionnel - desactive le bouton Google si absent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/auth/google/callback
